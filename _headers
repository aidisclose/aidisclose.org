# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Force HTTPS for two years, including subdomains (counter.aidisclose.org is
  # HTTPS-only too). Remove `preload` unless you also submit the domain to
  # hstspreload.org — the directive is a promise, not a request.
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  # The page is not meant to be framed by anyone.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  # No camera/mic/geolocation/payment use, so surrender the permissions outright.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # connect-src: the counter Worker (page load + generate) and raw.githubusercontent
  # (the Overleaf button inlines the package sources). form-action: Overleaf, the
  # only POST target. font-src/style-src are 'self' now that fonts are local.
  # 'unsafe-inline' for script-src is required by the pre-paint theme script and
  # the onclick handlers; see README.md for what removing it would take.
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://counter.aidisclose.org https://raw.githubusercontent.com; form-action https://www.overleaf.com

# Fonts are content-hashed by Google and never change under a given filename.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS are neither hashed nor versioned, so Cloudflare Pages' default of
# 4 hours (max-age=14400) meant a deploy could sit invisible in a returning
# visitor's browser for hours — the HTML page itself already revalidates on
# every load (max-age=0 below), but a linked stylesheet or script did not,
# so a deploy could change colours/behaviour on the server while browsers
# kept rendering the previous file. no-cache still lets the browser reuse the
# cached bytes on a 304, it just requires asking first.
/css/*
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
